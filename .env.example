# ==============================================================================
# CyberPulse SOC Suite: Environment Configuration (.env.example)
# Copy to .env and configure for live production deployments
# ==============================================================================

# Explicit lab declaration: the attack simulator refuses to run without it.
# Only set this on a lab you own or are authorised to test.
CYBERPULSE_LAB_MODE=false
# Simulated events may only target hosts inside these CIDRs (via the lab inventory)
# and these cloud accounts/tenants (shell patterns).
CYBERPULSE_LAB_CIDRS=10.0.0.0/16
CYBERPULSE_LAB_CLOUD_TARGETS=aws-lab-account-*,cyberpulse-lab.onmicrosoft.com
# Dummy accounts simulated credential attacks (brute force) may name
CYBERPULSE_LAB_ACCOUNTS=lab.*
# Per-minute caps on simulations triggered via the API/UI (brute force has its own cap)
SIM_BRUTE_FORCE_PER_MIN=6
SIM_PER_MIN=60

# Core SOAR Server
PORT=5000
# Bind address. 127.0.0.1 (default) keeps the console local. 0.0.0.0 exposes the
# console and API on every interface: only do that behind a firewall and a TLS
# reverse proxy. (The Docker image sets 0.0.0.0 inside the container and
# docker-compose publishes it on 127.0.0.1 only.)
HOST=127.0.0.1
# Syslog UDP listener bind address (same reasoning)
SYSLOG_HOST=127.0.0.1
# Containment policy. APPROVAL_REQUIRED (default) stages every disruptive action
# for an analyst; DRY_RUN only logs; AUTOMATIC executes and is refused unless
# CYBERPULSE_ALLOW_FULL_AUTO=true is also set.
POLICY_MODE=APPROVAL_REQUIRED
CYBERPULSE_ALLOW_FULL_AUTO=false
# Rule confidence (0-1) below which the engine escalates to an analyst instead of proposing containment
CONFIDENCE_THRESHOLD=0.8
# Max containment executions per rolling hour; beyond it, actions wait for approval
CONTAINMENT_MAX_ACTIONS_PER_HOUR=20
# Isolation circuit breaker: this many distinct hosts isolated within the window
# engages the kill switch and pages a human
ISOLATION_BREAKER_MAX_HOSTS=3
ISOLATION_BREAKER_WINDOW_MIN=10
# Extra assets SOAR may never isolate or block (hostnames, patterns, IPs, CIDRs).
# Built-in defaults already cover the DC (10.0.0.10 / WIN-DC01*), the SOC subnet
# 10.0.1.0/24 and JUMP-*/PAW-* admin hosts.
PROTECTED_ASSETS=
# Extra accounts SOAR may never lock/reset/revoke (names or patterns, domain ignored).
# Defaults: krbtgt, Administrator, breakglass*, emergency-*, svc_cyberpulse_soar, svc_backup
PROTECTED_ACCOUNTS=
# Isolation / perimeter-block TTLs in minutes; expired actions are rolled back automatically
ISOLATION_TTL_MIN=240
IP_BLOCK_TTL_MIN=1440
# Start with the global kill switch engaged (no containment executes until released)
CYBERPULSE_KILL_SWITCH=false

# Deployment environment: development (default) or production.
# In production, CYBERPULSE_API_KEY is REQUIRED and the dev default key is refused.
CYBERPULSE_ENV=development

# REST API authentication key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Leave unset in development to get a random per-run key printed at startup.
# Never commit a real value; keep secrets in .env (git-ignored) or a secrets manager.
CYBERPULSE_API_KEY=

# OpenSearch admin password for deploy/docker-compose.yml (required by compose)
OPENSEARCH_ADMIN_PASSWORD=

# Dashboard session lifetime (minutes) and whether the cookie is marked Secure
# (defaults to true when CYBERPULSE_ENV=production; requires HTTPS in front of the app)
SESSION_TTL_MIN=480
COOKIE_SECURE=false

# CORS origin allowed to call the REST API from a browser
CORS_ALLOWED_ORIGIN=http://localhost:5000

# API hardening knobs
CYBERPULSE_LOG_LEVEL=INFO
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=240
AUTH_FAILURE_LIMIT_PER_MINUTE=10

# Shared secret for HMAC-signed webhooks to POST /api/ingest (receiver disabled when empty).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sign with scripts/send_signed_event.py or soar.ingest_auth.sign_payload().
INGEST_HMAC_SECRET=

# Mask account names in the console, API responses and reports ("CORP\j***e").
# Set to false only when an analyst needs full names for a real investigation.
PRIVACY_MASK_USERNAMES=true

# Allow webhook dispatch to private/internal IP targets (SSRF guard opt-out)
ALLOW_INTERNAL_WEBHOOKS=false

# Threat Intelligence APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_v3_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_v2_key_here
MISP_URL=https://misp.corp.local:8443
MISP_API_KEY=your_misp_auth_key_here

# SIEM & Case Management Endpoints
WAZUH_API_URL=https://10.0.1.10:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me

THEHIVE_URL=http://10.0.1.20:9000
THEHIVE_API_KEY=your_thehive_5_api_key_here

# Notification Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your_workspace/your_channel_token

# Endpoint Remote Management
# WinRM responder: HTTPS only, certificate validation always on (cannot be disabled)
WINRM_ENDPOINT=https://10.0.0.10:5986/wsman
WINRM_VERIFY_TLS=true
# CA bundle that signed the WinRM listener certificate (empty = system trust store)
WINRM_CA_BUNDLE=
# Dedicated least-privilege service account (never Domain Admin); see docs/SERVICE_ACCOUNT.md
WINRM_USER=CORP\svc_cyberpulse_soar
WINRM_PASSWORD=change-me

PFSENSE_API_URL=https://10.0.0.1:8443/api/v1/firewall/rule
PFSENSE_API_KEY=your_pfsense_auth_token_here
