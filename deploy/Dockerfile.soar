FROM python:3.12-slim

# Run as an unprivileged user
RUN useradd --create-home --shell /usr/sbin/nologin cyberpulse

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY simulator/ ./simulator/
COPY scripts/ ./scripts/
COPY soar/ ./soar/
COPY rules/ ./rules/
COPY web/ ./web/
COPY server.py ./

USER cyberpulse

ENV PYTHONUNBUFFERED=1 \
    CYBERPULSE_ENV=production \
    PORT=5000 \
    HOST=0.0.0.0

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5000/healthz', timeout=4).status == 200 else 1)"]

CMD ["python", "server.py"]
