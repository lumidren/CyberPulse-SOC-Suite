<!-- Production Wazuh Rules Mapped from Sigma YAML -->
<group name="sysmon,windows_security,soc_custom_rules,">

  <!-- Rule 100010: T1003.001 LSASS Memory Dumping -->
  <rule id="100010" level="14">
    <decoded_as>sysmon-processaccess</decoded_as>
    <field name="target_image">\\lsass\.exe$</field>
    <field name="granted_access">^0x1010$|^0x1400$</field>
    <description>SOC-ALERT: Unauthorized process memory handle acquired targeting lsass.exe by $(source_image) [MITRE T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass_dump,</group>
  </rule>

  <!-- Rule 100011: T1110.001 RDP Password Brute Force Threshold -->
  <rule id="100011" level="11" frequency="10" timeframe="300">
    <decoded_as>win-rdp-auth-fail</decoded_as>
    <same_srcip />
    <description>SOC-ALERT: RDP Authentication failure spike (>10 failures in 5m) from $(src_ip) [MITRE T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>credential_access,brute_force,</group>
  </rule>

  <!-- Rule 100012: T1053.005 Persistence via Scheduled Task -->
  <rule id="100012" level="12">
    <if_sid>60144</if_sid>
    <field name="win.eventdata.taskContent">powershell|cmd\.exe|http:|https:</field>
    <description>SOC-ALERT: High-risk Scheduled Task creation with script execution payload $(win.eventdata.taskName) [MITRE T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

  <!-- Rule 100013: T1562.001 Impair Defenses (Windows Defender Tamper) -->
  <rule id="100013" level="14">
    <if_sid>60103</if_sid>
    <field name="win.eventdata.commandLine">Set-MpPreference.*DisableRealtimeMonitoring</field>
    <description>SOC-ALERT: Defense Evasion - Windows Defender real-time protection disabled [MITRE T1562.001]</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,defender_tamper,</group>
  </rule>

  <!-- Rule 100014: T1486 Data Encrypted for Impact (Ransomware Canary) -->
  <rule id="100014" level="15">
    <if_sid>60104</if_sid>
    <field name="win.eventdata.targetFilename">\.locked$|\.encrypted$|HOW_TO_DECRYPT</field>
    <description>SOC-ALERT: Ransomware canary file encrypted in finance segment [MITRE T1486]</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>impact,ransomware,</group>
  </rule>

</group>
