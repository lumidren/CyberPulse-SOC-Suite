{
  "title": "CyberPulse SOC Lab",
  "uid": "cyberpulse-lab",
  "schemaVersion": 39,
  "tags": [
    "cyberpulse",
    "lab"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kill switch engaged",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "cyberpulse_kill_switch_engaged"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pending approvals",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "cyberpulse_pending_approvals"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Containment executions (last hour)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "cyberpulse_containment_executions_last_hour"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Incidents by status",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (cyberpulse_incidents)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "In-process pipeline latency p95 (lab-measured, ms)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cyberpulse_pipeline_latency_ms_bucket[15m])))"
        }
      ]
    }
  ]
}
