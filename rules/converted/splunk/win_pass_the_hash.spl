``` SOC-RULE-012: Pass-the-Hash Logon Patterns (NTLM and seclogo) (generated from rules/sigma/win_pass_the_hash.yml; review before use) ```
index=* (source="*Security*") | where ((match('EventCode', "(?i)^4624$") AND match('LogonType', "(?i)^9$") AND match('LogonProcessName', "(?i)^seclogo$") AND match('AuthenticationPackageName', "(?i)^Negotiate$")) AND NOT (match('TargetUserName', "(?i)^ANONYMOUS\\ LOGON$"))) OR ((match('EventCode', "(?i)^4624$") AND match('LogonType', "(?i)^3$") AND match('AuthenticationPackageName', "(?i)^NTLM$") AND match('KeyLength', "(?i)^0$") AND match('LogonProcessName', "(?i)^NtLmSsp$")) AND NOT (match('TargetUserName', "(?i)^ANONYMOUS\\ LOGON$")))
