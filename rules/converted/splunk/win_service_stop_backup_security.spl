``` SOC-RULE-040: Backup or Security Service Stopped via net or sc (generated from rules/sigma/win_service_stop_backup_security.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where (((match('Image', "(?i)\\\\net\\.exe$") OR match('Image', "(?i)\\\\net1\\.exe$") OR match('Image', "(?i)\\\\sc\\.exe$"))) AND ((match('CommandLine', "(?i)stop") OR match('CommandLine', "(?i)config"))) AND ((match('CommandLine', "(?i)veeam") OR match('CommandLine', "(?i)backup") OR match('CommandLine', "(?i)vss") OR match('CommandLine', "(?i)sql") OR match('CommandLine', "(?i)WinDefend") OR match('CommandLine', "(?i)sophos") OR match('CommandLine', "(?i)MsMpSvc") OR match('CommandLine', "(?i)wbengine"))))
