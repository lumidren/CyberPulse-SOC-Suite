``` SOC-RULE-039: Rclone Copying Data to Cloud Storage (generated from rules/sigma/win_rclone_exfiltration.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where ((match('Image', "(?i)\\\\rclone\\.exe$") AND (match('CommandLine', "(?i)\\ copy\\ ") OR match('CommandLine', "(?i)\\ sync\\ ") OR match('CommandLine', "(?i)\\ move\\ ")))) OR (((match('CommandLine', "(?i)\\-\\-config") AND match('CommandLine', "(?i)\\-\\-no\\-check\\-certificate")))) OR (((match('CommandLine', "(?i)mega:") OR match('CommandLine', "(?i)s3:") OR match('CommandLine', "(?i)drive:") OR match('CommandLine', "(?i)dropbox:") OR match('CommandLine', "(?i)ftp:")) AND match('CommandLine', "(?i)\\ copy\\ ")))
