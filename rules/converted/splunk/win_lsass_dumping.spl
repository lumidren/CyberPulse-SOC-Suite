``` SOC-RULE-001: OS Credential Dumping via LSASS Memory Access (generated from rules/sigma/win_lsass_dumping.yml; review before use) ```
index=* (EventCode=10) | where ((match('TargetImage', "(?i)\\\\lsass\\.exe$") AND (match('GrantedAccess', "(?i)0x1010") OR match('GrantedAccess', "(?i)0x1400") OR match('GrantedAccess', "(?i)0x1F0FFF"))) AND NOT ((match('SourceImage', "(?i)\\\\svchost\\.exe$") OR match('SourceImage', "(?i)\\\\csrss\\.exe$") OR match('SourceImage', "(?i)\\\\MsMpEng\\.exe$"))))
