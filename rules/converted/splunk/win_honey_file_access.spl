``` SOC-RULE-047: Access to a Canary File (generated from rules/sigma/win_honey_file_access.yml; review before use) ```
index=* (source="*Security*") | where ((match('EventCode', "(?i)^4663$") AND (match('ObjectName', "(?i)\\\\Passwords_2019\\.xlsx$") OR match('ObjectName', "(?i)\\\\vpn_credentials\\.txt$") OR match('ObjectName', "(?i)\\\\Payroll_Q4_FINAL\\.xlsx$"))) AND NOT ((match('ProcessName', "(?i)\\\\MsMpEng\\.exe$") OR match('ProcessName', "(?i)\\\\wbengine\\.exe$"))))
