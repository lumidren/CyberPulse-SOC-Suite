``` SOC-RULE-052: Executable Downloaded over HTTP by a Script Client or to a Raw IP (generated from rules/sigma/net_zeek_http_executable_from_script_client.yml; review before use) ```
index=* (source="*zeek:http*") | where ((match('resp_mime_types', "(?i)application/x\\-dosexec")) AND ((match('user_agent', "(?i)WindowsPowerShell") OR match('user_agent', "(?i)Microsoft\\-CryptoAPI") OR match('user_agent', "(?i)BITS") OR match('user_agent', "(?i)curl") OR match('user_agent', "(?i)Wget")))) OR ((match('resp_mime_types', "(?i)application/x\\-dosexec")) AND (match('host', "(?i)^[0-9]{1,3}(\\.[0-9]{1,3}){3}(:[0-9]+)?$")))
