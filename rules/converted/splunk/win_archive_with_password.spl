``` SOC-RULE-038: Password-Protected Archive Created with 7-Zip or WinRAR (generated from rules/sigma/win_archive_with_password.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where (((match('Image', "(?i)\\\\7z\\.exe$") OR match('Image', "(?i)\\\\7za\\.exe$") OR match('Image', "(?i)\\\\rar\\.exe$") OR match('Image', "(?i)\\\\WinRAR\\.exe$"))) AND ((match('CommandLine', "(?i)\\ a\\ ") OR match('CommandLine', "(?i)\\ \\-a\\ "))) AND ((match('CommandLine', "(?i)\\ \\-p") OR match('CommandLine', "(?i)\\ \\-hp"))))
