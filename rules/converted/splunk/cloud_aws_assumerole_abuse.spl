``` SOC-RULE-009: Suspicious AWS STS AssumeRole Abuse Across External Account (generated from rules/sigma/cloud_aws_assumerole_abuse.yml; review before use) ```
index=* (source="*aws:cloudtrail*") | where ((match('eventName', "(?i)^AssumeRole$") AND match('eventSource', "(?i)^sts\\.amazonaws\\.com$")) AND ((match('requestParameters.roleArn', "(?i)OrganizationAccountAccessRole") OR match('requestParameters.roleArn', "(?i)AdministratorAccess") OR match('requestParameters.roleArn', "(?i)SecurityAudit"))) AND NOT ((match('sourceIPAddress', "(?i)^10\\.") OR match('sourceIPAddress', "(?i)^172\\.16\\.") OR match('sourceIPAddress', "(?i)^192\\.168\\."))))
