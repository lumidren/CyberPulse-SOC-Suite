``` SOC-RULE-019: Volume Shadow Copy Deletion or Resizing (generated from rules/sigma/win_ransomware_shadow_copy_deletion.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where ((match('Image', "(?i)\\\\vssadmin\\.exe$") AND (match('CommandLine', "(?i)delete\\ shadows") OR match('CommandLine', "(?i)resize\\ shadowstorage")))) OR ((match('Image', "(?i)\\\\wmic\\.exe$") AND (match('CommandLine', "(?i)shadowcopy") AND match('CommandLine', "(?i)delete")))) OR (((match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$")) AND (match('CommandLine', "(?i)Win32_ShadowCopy") AND match('CommandLine', "(?i)Delete"))))
