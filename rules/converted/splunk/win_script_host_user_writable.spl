``` SOC-RULE-023: Script Host Running a Script from a User-Writable Path (generated from rules/sigma/win_script_host_user_writable.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where (((match('Image', "(?i)\\\\wscript\\.exe$") OR match('Image', "(?i)\\\\cscript\\.exe$"))) AND ((match('CommandLine', "(?i)\\\\Downloads\\\\") OR match('CommandLine', "(?i)\\\\AppData\\\\") OR match('CommandLine', "(?i)\\\\Temp\\\\") OR match('CommandLine', "(?i)\\\\Users\\\\Public\\\\"))) AND ((match('CommandLine', "(?i)\\.js") OR match('CommandLine', "(?i)\\.jse") OR match('CommandLine', "(?i)\\.vbs") OR match('CommandLine', "(?i)\\.vbe") OR match('CommandLine', "(?i)\\.wsf"))))
