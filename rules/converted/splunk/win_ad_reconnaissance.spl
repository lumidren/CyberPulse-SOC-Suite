``` SOC-RULE-034: Active Directory Reconnaissance Commands (generated from rules/sigma/win_ad_reconnaissance.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where (((match('Image', "(?i)\\\\net\\.exe$") OR match('Image', "(?i)\\\\net1\\.exe$")) AND (match('CommandLine', "(?i)group\\ \"domain\\ admins\"") OR match('CommandLine', "(?i)group\\ \"enterprise\\ admins\"") OR match('CommandLine', "(?i)group\\ domain\\ admins")))) OR ((match('Image', "(?i)\\\\nltest\\.exe$") AND (match('CommandLine', "(?i)/domain_trusts") OR match('CommandLine', "(?i)/dclist")))) OR (((match('CommandLine', "(?i)adfind") OR match('CommandLine', "(?i)\\-sc\\ trustdmp") OR match('CommandLine', "(?i)objectcategory=person"))))
