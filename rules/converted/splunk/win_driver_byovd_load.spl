``` SOC-RULE-011: Vulnerable Signed Driver Load (BYOVD Evasion) (generated from rules/sigma/win_driver_byovd_load.yml; review before use) ```
index=* (source="*Microsoft-Windows-Sysmon/Operational*" OR source="*sysmon*") | where ((match('EventCode', "(?i)^6$") AND (match('ImageLoaded', "(?i)\\\\gdrv\\.sys$") OR match('ImageLoaded', "(?i)\\\\mhyprot2\\.sys$") OR match('ImageLoaded', "(?i)\\\\procexp\\.sys$") OR match('ImageLoaded', "(?i)\\\\RTCore64\\.sys$") OR match('ImageLoaded', "(?i)\\\\DBUtil_2_3\\.sys$"))) AND NOT (match('Signed', "(?i)^true$") AND match('SignatureStatus', "(?i)^Valid$") AND match('ImageLoaded', "(?i)^C:\\\\Windows\\\\System32\\\\drivers\\\\")))
