``` SOC-RULE-021: Office Application Spawning a Shell or Script Host (generated from rules/sigma/win_office_spawns_shell.yml; review before use) ```
index=* (EventCode=1 OR EventCode=4688) | where (((match('ParentImage', "(?i)\\\\WINWORD\\.EXE$") OR match('ParentImage', "(?i)\\\\EXCEL\\.EXE$") OR match('ParentImage', "(?i)\\\\POWERPNT\\.EXE$") OR match('ParentImage', "(?i)\\\\OUTLOOK\\.EXE$"))) AND ((match('Image', "(?i)\\\\cmd\\.exe$") OR match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$") OR match('Image', "(?i)\\\\wscript\\.exe$") OR match('Image', "(?i)\\\\cscript\\.exe$") OR match('Image', "(?i)\\\\mshta\\.exe$"))))
