// SOC-RULE-019: Volume Shadow Copy Deletion or Resizing (generated from rules/sigma/win_ransomware_shadow_copy_deletion.yml; review before use)
DeviceProcessEvents
| where ((FolderPath endswith "\\vssadmin.exe" and (ProcessCommandLine contains "delete shadows" or ProcessCommandLine contains "resize shadowstorage"))) or ((FolderPath endswith "\\wmic.exe" and (ProcessCommandLine contains "shadowcopy" and ProcessCommandLine contains "delete"))) or (((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains "Win32_ShadowCopy" and ProcessCommandLine contains "Delete")))
