// SOC-RULE-008: Active Directory Replication Abuse (DCSync) via Non-DC Account (generated from rules/sigma/win_dcsync.yml; review before use)
SecurityEvent
| where ((EventID =~ "4662" and AccessMask =~ "0x100" and (Properties contains "1131f6aa-9c07-11d1-f79f-00c04fc2dcd2" or Properties contains "1131f6ad-9c07-11d1-f79f-00c04fc2dcd2")) and not (SubjectUserName endswith "$"))
