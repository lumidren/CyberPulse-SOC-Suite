// SOC-RULE-017: Rundll32 Executing Script or Remote Content (generated from rules/sigma/win_lolbas_rundll32_script.yml; review before use)
DeviceProcessEvents
| where ((FolderPath endswith "\\rundll32.exe") and ((ProcessCommandLine contains "javascript:" or ProcessCommandLine contains "RunHTMLApplication" or ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://")))
