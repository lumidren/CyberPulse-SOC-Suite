// SOC-RULE-046: Authentication Attempt Against a Honey Account (generated from rules/sigma/win_honey_account_activity.yml; review before use)
SecurityEvent
| where (((EventID =~ "4624" or EventID =~ "4625" or EventID =~ "4648" or EventID =~ "4768" or EventID =~ "4769" or EventID =~ "4771" or EventID =~ "4776")) and ((TargetUserName =~ "svc_sql_legacy" or TargetUserName =~ "adm_backup_old")))
