// SOC-RULE-019: Volume Shadow Copy Deletion or Resizing (generated from rules/sigma/win_ransomware_shadow_copy_deletion.yml; review before use)
(event.code:1 OR event.code:4688) AND ((process.executable:*\\vssadmin.exe AND (process.command_line:*delete\ shadows* OR process.command_line:*resize\ shadowstorage*))) OR ((process.executable:*\\wmic.exe AND (process.command_line:*shadowcopy* AND process.command_line:*delete*))) OR (((process.executable:*\\powershell.exe OR process.executable:*\\pwsh.exe) AND (process.command_line:*Win32_ShadowCopy* AND process.command_line:*Delete*)))
