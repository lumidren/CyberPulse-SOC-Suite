// SOC-RULE-023: Script Host Running a Script from a User-Writable Path (generated from rules/sigma/win_script_host_user_writable.yml; review before use)
(event.code:1 OR event.code:4688) AND ((((process.executable:*\\wscript.exe OR process.executable:*\\cscript.exe)) AND ((process.command_line:*\\Downloads\\* OR process.command_line:*\\AppData\\* OR process.command_line:*\\Temp\\* OR process.command_line:*\\Users\\Public\\*)) AND ((process.command_line:*.js* OR process.command_line:*.jse* OR process.command_line:*.vbs* OR process.command_line:*.vbe* OR process.command_line:*.wsf*))))
