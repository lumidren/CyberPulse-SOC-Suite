// SOC-RULE-040: Backup or Security Service Stopped via net or sc (generated from rules/sigma/win_service_stop_backup_security.yml; review before use)
(event.code:1 OR event.code:4688) AND (((process.executable:*\\net.exe OR process.executable:*\\net1.exe OR process.executable:*\\sc.exe)) AND ((process.command_line:*stop* OR process.command_line:*config*)) AND ((process.command_line:*veeam* OR process.command_line:*backup* OR process.command_line:*vss* OR process.command_line:*sql* OR process.command_line:*WinDefend* OR process.command_line:*sophos* OR process.command_line:*MsMpSvc* OR process.command_line:*wbengine*)))
