// SOC-RULE-020: Backup Catalog Deletion or Boot Recovery Disabled (generated from rules/sigma/win_ransomware_recovery_inhibition.yml; review before use)
(event.code:1 OR event.code:4688) AND ((process.executable:*\\wbadmin.exe AND (process.command_line:*delete\ catalog* OR process.command_line:*delete\ systemstatebackup*))) OR ((process.executable:*\\bcdedit.exe AND (process.command_line:*recoveryenabled\ no* OR process.command_line:*bootstatuspolicy\ ignoreallfailures*)))
