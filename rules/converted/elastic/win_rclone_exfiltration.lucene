// SOC-RULE-039: Rclone Copying Data to Cloud Storage (generated from rules/sigma/win_rclone_exfiltration.yml; review before use)
(event.code:1 OR event.code:4688) AND ((process.executable:*\\rclone.exe AND (process.command_line:*\ copy\ * OR process.command_line:*\ sync\ * OR process.command_line:*\ move\ *))) OR (((process.command_line:*\-\-config* AND process.command_line:*\-\-no\-check\-certificate*))) OR (((process.command_line:*mega\:* OR process.command_line:*s3\:* OR process.command_line:*drive\:* OR process.command_line:*dropbox\:* OR process.command_line:*ftp\:*) AND process.command_line:*\ copy\ *))
