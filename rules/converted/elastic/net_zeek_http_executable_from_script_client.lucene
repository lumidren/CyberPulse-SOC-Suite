// SOC-RULE-052: Executable Downloaded over HTTP by a Script Client or to a Raw IP (generated from rules/sigma/net_zeek_http_executable_from_script_client.yml; review before use)
((winlog.event_data.resp_mime_types:*application\/x\-dosexec*) AND ((winlog.event_data.user_agent:*WindowsPowerShell* OR winlog.event_data.user_agent:*Microsoft\-CryptoAPI* OR winlog.event_data.user_agent:*BITS* OR winlog.event_data.user_agent:*curl* OR winlog.event_data.user_agent:*Wget*))) OR ((winlog.event_data.resp_mime_types:*application\/x\-dosexec*) AND (winlog.event_data.host:/^[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?$/))
