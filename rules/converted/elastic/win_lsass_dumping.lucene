// SOC-RULE-001: OS Credential Dumping via LSASS Memory Access (generated from rules/sigma/win_lsass_dumping.yml; review before use)
(event.code:10) AND (((winlog.event_data.TargetImage:*\\lsass.exe AND (winlog.event_data.GrantedAccess:*0x1010* OR winlog.event_data.GrantedAccess:*0x1400* OR winlog.event_data.GrantedAccess:*0x1F0FFF*)) AND NOT ((winlog.event_data.SourceImage:*\\svchost.exe OR winlog.event_data.SourceImage:*\\csrss.exe OR winlog.event_data.SourceImage:*\\MsMpEng.exe))))
