// SOC-RULE-038: Password-Protected Archive Created with 7-Zip or WinRAR (generated from rules/sigma/win_archive_with_password.yml; review before use)
(event.code:1 OR event.code:4688) AND (((process.executable:*\\7z.exe OR process.executable:*\\7za.exe OR process.executable:*\\rar.exe OR process.executable:*\\WinRAR.exe)) AND ((process.command_line:*\ a\ * OR process.command_line:*\ \-a\ *)) AND ((process.command_line:*\ \-p* OR process.command_line:*\ \-hp*)))
