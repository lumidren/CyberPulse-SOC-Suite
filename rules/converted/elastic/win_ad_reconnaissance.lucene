// SOC-RULE-034: Active Directory Reconnaissance Commands (generated from rules/sigma/win_ad_reconnaissance.yml; review before use)
(event.code:1 OR event.code:4688) AND ((((process.executable:*\\net.exe OR process.executable:*\\net1.exe) AND (process.command_line:*group\ \"domain\ admins\"* OR process.command_line:*group\ \"enterprise\ admins\"* OR process.command_line:*group\ domain\ admins*))) OR ((process.executable:*\\nltest.exe AND (process.command_line:*\/domain_trusts* OR process.command_line:*\/dclist*))) OR (((process.command_line:*adfind* OR process.command_line:*\-sc\ trustdmp* OR process.command_line:*objectcategory\=person*))))
