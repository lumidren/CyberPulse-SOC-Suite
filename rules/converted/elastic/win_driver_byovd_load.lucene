// SOC-RULE-011: Vulnerable Signed Driver Load (BYOVD Evasion) (generated from rules/sigma/win_driver_byovd_load.yml; review before use)
(event.code:6) AND ((((winlog.event_data.ImageLoaded:*\\gdrv.sys OR winlog.event_data.ImageLoaded:*\\mhyprot2.sys OR winlog.event_data.ImageLoaded:*\\procexp.sys OR winlog.event_data.ImageLoaded:*\\RTCore64.sys OR winlog.event_data.ImageLoaded:*\\DBUtil_2_3.sys)) AND NOT (winlog.event_data.Signed:true AND winlog.event_data.SignatureStatus:Valid AND winlog.event_data.ImageLoaded:C\:\\Windows\\System32\\drivers\\*)))
